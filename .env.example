DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para PostgreSQL local, defina DATABASE_URL. Sem ela, o desenvolvimento usa SQLite.
# DATABASE_URL=postgresql://sidcar:senha@localhost:5432/sidcar
# Em produção, configure credenciais do bucket S3 compatível (AWS, R2 ou Supabase Storage).
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
